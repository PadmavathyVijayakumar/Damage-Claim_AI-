# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mindwave:mindwave@localhost:5432/damageclaim

# ── Cache ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Time-series (cold-chain sensor storage) ───────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_token_here
INFLUXDB_ORG=mindwave
INFLUXDB_BUCKET=cold_chain

# ── Event bus ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── Evidence object store ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
S3_EVIDENCE_BUCKET=mindwave-evidence

# ── Vision AI ─────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/weights/yolov9_damage.pt
CLASSIFIER_MODEL_PATH=models/weights/efficientnet_damage.pt
OPENAI_API_KEY=your_openai_key
VLLM_CONFIDENCE_THRESHOLD=0.72

# ── Cold-chain models ─────────────────────────────────────────────────
LSTM_MODEL_PATH=models/weights/lstm_temp.pt
LSTM_AE_MODEL_PATH=models/weights/lstm_ae.pt
ANN_RISK_MODEL_PATH=models/weights/ann_risk.h5
EXCURSION_ALERT_HORIZON_MIN=60

# ── WMS connectors ────────────────────────────────────────────────────
MANHATTAN_API_BASE_URL=https://your-manhattan-instance/api
MANHATTAN_CLIENT_ID=your_client_id
MANHATTAN_CLIENT_SECRET=your_secret

SAP_EWM_HOST=https://your-sap-host
SAP_BTP_TOKEN_URL=https://your-btp.authentication.sap.hana.ondemand.com/oauth/token
SAP_CLIENT_ID=your_client_id
SAP_CLIENT_SECRET=your_secret

BLUE_YONDER_API_BASE=https://your-by-instance.luminate.jda.com
BLUE_YONDER_CLIENT_ID=your_client_id
BLUE_YONDER_CLIENT_SECRET=your_secret

ORACLE_WMS_HOST=https://your-oracle-wms-host
ORACLE_OIC_BASE=https://your-oic-instance
ORACLE_CLIENT_ID=your_client_id
ORACLE_CLIENT_SECRET=your_secret

# ── ERP connectors ────────────────────────────────────────────────────
SAP_S4_HOST=https://your-s4-host
ORACLE_ERP_HOST=https://your-oracle-erp-host

# ── API security ──────────────────────────────────────────────────────
API_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
